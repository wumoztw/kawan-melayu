    {
      "id": 9,
      "title": "搭車與導航",
      "subtitle": "Ride-Hailing & Navigation",
      "lessons": [
        {
          "id": "9-1",
          "title": "方向指引",
          "distractors": [
            "jauh",
            "dekat"
          ],
          "steps": [
            {
              "ms": "Jalan terus",
              "zh": "直走"
            },
            {
              "ms": "Belok kiri",
              "zh": "左轉"
            },
            {
              "ms": "Belok kanan",
              "zh": "右轉"
            },
            {
              "ms": "Stesen bas dekat",
              "zh": "巴士站很近"
            }
          ]
        },
        {
          "id": "9-2",
          "title": "與司機溝通",
          "distractors": [
            "kiri",
            "jauh"
          ],
          "steps": [
            {
              "ms": "Saya mau ke sana",
              "zh": "我要去那裡"
            },
            {
              "ms": "Berhenti di sini",
              "zh": "在這裡停車"
            },
            {
              "ms": "Berhenti di depan",
              "zh": "在前面停車"
            },
            {
              "ms": "Lapangan terbang jauh",
              "zh": "機場很遠"
            }
          ]
        }
      ]
    },
    {
      "id": 10,
      "title": "社交破冰與自我介紹",
      "subtitle": "Social & Identity",
      "lessons": [
        {
          "id": "10-1",
          "title": "自我介紹",
          "distractors": [
            "siapa",
            "kawan"
          ],
          "steps": [
            {
              "ms": "Apa khabar?",
              "zh": "你好嗎？"
