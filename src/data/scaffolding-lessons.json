            {
              "ms": "Saya mau saiz kecil",
              "zh": "我要小尺寸"
            },
            {
              "ms": "Ada warna hitam?",
              "zh": "有黑色嗎？"
            },
            {
              "ms": "Saya mau warna merah",
              "zh": "我要紅色"
            }
          ]
        },
        {
          "id": "8-2",
          "title": "價格評價與殺價",
          "distractors": [
