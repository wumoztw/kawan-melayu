              "zh": "這個貴"
            },
            {
              "ms": "Itu murah",
              "zh": "那個便宜"
            },
            {
              "ms": "Berapa ringgit?",
              "zh": "多少令吉？"
            },
            {
              "ms": "Boleh murah sikit?",
              "zh": "可以便宜一點嗎？"
            }
          ]
        }
      ]
